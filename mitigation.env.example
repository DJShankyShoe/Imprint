# Imprint mitigation actions (PoC) - generated by install_imprint.sh
# Format: KEY='value'

# Google reCAPTCHA v2 (CAPTCHA action)
RECAPTCHA_V2_SITEKEY=''
RECAPTCHA_V2_SECRET=''

# HONEYPOT action - where flagged visitors are sent
# Leave empty for the POC (same host, port 8443)
HONEYPOT_URL=''

# OTP action (SMTP accounts)
GMAIL_USER=''
GMAIL_APP_PASS=''
OUTLOOK_USER=''
OUTLOOK_APP_PASS=''
