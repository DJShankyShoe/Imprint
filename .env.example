# Imprint credentials (generated by install_imprint.sh)
# Format: KEY='value'

# MongoDB
MONGO_ROOT_USER='root'
MONGO_ROOT_PASSWORD=''
MONGO_USER='imprint_user'
MONGO_PASSWORD=''
MONGO_DB='imprint'

# Imprint service
IMPRINT_SITE_TOKEN=''
IMPRINT_ALERT_TOKEN=''
IMPRINT_BIND='127.0.0.1:8080'

# Public path of the collector script (empty = /assets/js/app.min.js)
IMPRINT_COLLECTOR_PATH=''

# IP geolocation provider ({ip} = visitor IP, empty = ip-api.com)
IMPRINT_GEO_URL=''
IMPRINT_GEO_TIMEOUT=''

# Mitigation advisor (Claude API)
ANTHROPIC_API_KEY=''

# POC (SpaceY users, Splunk password)
SPACEY_USERS=''
SPLUNK_PASSWORD=''
