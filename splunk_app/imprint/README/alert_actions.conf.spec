# Imprint Alert action parameters
[imprintAlert]
param.field_name = <string>
* Field with the UID or JWE token (default: UID)

param.data_format = [plain|encrypted]
* plain = UID, encrypted = JWE token (default: plain)

param.service_url = <string>
* Imprint service URL (e.g., http://imprint:8080)

param.token = <string>
* Imprint alert token
